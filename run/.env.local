# .env.local — single-machine local dev/test configuration
#
# Uses mock_recipes and /tmp paths — no real toltec_db or citlali needed.
# Start Dagster with:
#   cd run && TOLTECPIPE_ENV_FILE=.env.local dagster dev

# Mock toltec_db (sqlite-backed test double — see tests/mock_toltec_db.py)
# When using a real MySQL instance, fill these in:
TOLTECPIPE_TOLTEC_DB_HOST=localhost
TOLTECPIPE_TOLTEC_DB_PORT=3306
TOLTECPIPE_TOLTEC_DB_NAME=toltec
TOLTECPIPE_TOLTEC_DB_USER=toltec
TOLTECPIPE_TOLTEC_DB_PASSWORD=toltec

# Use mock_recipes scripts (no citlali binary required)
TOLTECPIPE_RECIPES_ROOT=mock_recipes
TOLTECPIPE_CITLALI_BIN=/bin/echo

# Write reduced outputs under /tmp for local testing
TOLTECPIPE_DATA_LMT_ROOT=/tmp/toltecpipe_test/data_lmt
TOLTECPIPE_DATAPROD_TOLTEC_ROOT=/tmp/toltecpipe_test/dataprod_toltec

# Sensor: only look at recent data
TOLTECPIPE_SENSOR_START_DATE=2026-01-01

# Quartet: no disabled roaches in local test
# TOLTECPIPE_DISABLED_ROACH_INDICES=

# Use local SQLite Dagster backend (no PostgreSQL needed for dev)
# TOLTECPIPE_DAGSTER_POSTGRES_URL=
