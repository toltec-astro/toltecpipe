# .env.simulator — toltecpipe simulator mode configuration
#
# No MySQL or citlali binary required.  Uses mock_recipes and /tmp paths.
# Fires ql_map_job for each obsnum in TOLTECPIPE_SIMULATOR_OBSNUMS.
#
# Start simulator with (from run/ directory):
#   just sim
# Or manually:
#   set -a; source .env.simulator; set +a
#   TOLTECPIPE_SIMULATOR_ENABLED=true dagster dev

# Simulator mode — set to true to use simulator_sensor instead of quartet_sensor
TOLTECPIPE_SIMULATOR_ENABLED=true

# Comma-separated obsnums to dispatch (in order, one per sensor tick)
TOLTECPIPE_SIMULATOR_OBSNUMS=100001,100002,100003,100004,100005

# Loop back to first obsnum after all are dispatched (false = stop after last)
TOLTECPIPE_SIMULATOR_LOOP=false

# Seconds between simulator ticks
TOLTECPIPE_SIMULATOR_INTERVAL=30

# Use mock_recipes scripts (no citlali binary required)
TOLTECPIPE_RECIPES_ROOT=mock_recipes
TOLTECPIPE_CITLALI_BIN=/bin/echo

# Write reduced outputs under /tmp for simulator testing
TOLTECPIPE_DATA_LMT_ROOT=/tmp/toltecpipe_test/data_lmt
TOLTECPIPE_DATAPROD_TOLTEC_ROOT=/tmp/toltecpipe_test/dataprod_toltec

# APT file (can be a stub for simulator)
TOLTECPIPE_APT_FILE=common/apt.ecsv

# Validation settings not used in simulator mode but kept for completeness
TOLTECPIPE_MAX_INTERFACE_COUNT=14
# TOLTECPIPE_DISABLED_ROACH_INDICES=

# Use local SQLite Dagster backend
# TOLTECPIPE_DAGSTER_POSTGRES_URL=
