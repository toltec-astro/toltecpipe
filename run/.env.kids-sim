# .env.kids-sim — tolteca_db (KIDs pipeline, Machine A) simulator configuration
#
# Source database is a local SQLite snapshot of the real toltec MySQL DB.
# Run setup_sim_dirs.sh first to create the required directories and stub DB.
#
# Start kids simulator (from tolteca_db/run/ or use workspace two-loc):
#   set -a; source .env.kids-sim; set +a
#   dagster dev -f src/tolteca_db/dagster/definitions.py

# Simulator mode — replays from source SQLite instead of live MySQL
TOLTECA_SIMULATOR_ENABLED=true

# Source SQLite snapshot to replay quartets from
# Create with: cp /data_lmt/toltec_db/toltecdb.sqlite /tmp/toltecpipe_test/toltecdb_source.sqlite
TOLTEC_DB_SOURCE_URL=sqlite:////tmp/toltecpipe_test/toltecdb_source.sqlite

# Target tolteca_db metadata store (SQLite, written by pipeline)
TOLTECA_DB_URL=sqlite:////tmp/toltecpipe_test/tolteca_db.sqlite

# Data root (simulator will look for NC files here)
TOLTECA_WEB_DATA_LMT_ROOTPATH=/tmp/toltecpipe_test/data_lmt

# Cache root for KIDs pipeline products
TOLTECA_WEB_CACHE_ROOT=/tmp/toltecpipe_test/cache

# Simulator tick interval (seconds between new quartet injections)
TOLTECA_SIMULATOR_INTEGRATION_TIME=10.0

# Date filter: only replay quartets from this date onward
# TOLTECA_SIMULATOR_DATE=2026-01-01

# ObsNum filter: comma-separated list (if set, only these obsnums are replayed)
# TOLTECA_SIMULATOR_OBSNUMS=100001,100002,100003

# Disabled roach interfaces (JSON array)
TOLTECA_DISABLED_INTERFACES=[]

# Validation timeout (seconds to wait after last Valid=1 before declaring complete)
TOLTECA_VALIDATION_TIMEOUT=15.0
