# .env.example — copy to .env and fill in secrets
#
# Non-secret settings are in toltecpipe.yaml.
# This file holds passwords and deployment-specific overrides.
#
# Usage:
#   cp run/.env.example run/.env
#   # edit .env, then:
#   cd run && dagster dev

# toltec MySQL password (required)
TOLTECPIPE_TOLTEC_DB_PASSWORD=

# Override any yaml setting via env var (TOLTECPIPE_ prefix):
# TOLTECPIPE_DATA_LMT_ROOT=/data_lmt
# TOLTECPIPE_DATAPROD_TOLTEC_ROOT=/data_lmt/dataprod_toltec
# TOLTECPIPE_RECIPES_ROOT=/workspaces/toltec_astro_v2_3/run/taco_recipes/ql_maps
# TOLTECPIPE_CITLALI_BIN=/usr/local/bin/citlali
# TOLTECPIPE_DISABLED_ROACH_INDICES=3,7
# TOLTECPIPE_SENSOR_START_DATE=2026-01-01

# Point at YAML config (if not in cwd):
# TOLTECPIPE_CONFIG=/path/to/toltecpipe.yaml

# Shared Dagster PostgreSQL (production; leave blank for local SQLite dev):
# TOLTECPIPE_DAGSTER_POSTGRES_URL=postgresql://dagster:password@dbhost:5432/dagster
