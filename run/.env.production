# .env.production — production deployment configuration for Machine B (maps)
#
# Copy to .env and fill in site-specific values.
# Never commit this file with real credentials.
#
# Start Dagster:
#   cd run && TOLTECPIPE_ENV_FILE=.env.production dagster dev
# Or daemon mode:
#   cd run && TOLTECPIPE_ENV_FILE=.env.production dagster-daemon run

# --- toltec MySQL (data acquisition database, read-only) ---
TOLTECPIPE_TOLTEC_DB_HOST=toltec-db.lmt.local
TOLTECPIPE_TOLTEC_DB_PORT=3306
TOLTECPIPE_TOLTEC_DB_NAME=toltec
TOLTECPIPE_TOLTEC_DB_USER=toltec_reader
TOLTECPIPE_TOLTEC_DB_PASSWORD=FILL_IN_PASSWORD

# --- Filesystem paths ---
# NFS-mounted data_lmt (shared with Machine A)
TOLTECPIPE_DATA_LMT_ROOT=/data_lmt

# NFS-mounted dataprod output (shared with Machine A)
TOLTECPIPE_DATAPROD_TOLTEC_ROOT=/data_lmt/dataprod_toltec

# Real taco_recipes scripts (this repo's run/taco_recipes/ql_maps/)
TOLTECPIPE_RECIPES_ROOT=/opt/toltecpipe/run/taco_recipes/ql_maps

# APT file (updated manually by operators)
TOLTECPIPE_APT_FILE=/data_lmt/common/apt.ecsv

# citlali binary
TOLTECPIPE_CITLALI_BIN=/usr/local/bin/citlali

# --- Sensor behaviour ---
# Only process data after this date (prevents replaying all history on startup)
TOLTECPIPE_SENSOR_START_DATE=2026-01-01

# Roach indices disabled on this installation (comma-separated, no spaces)
# TOLTECPIPE_DISABLED_ROACH_INDICES=3,7

# Seconds to wait for all interfaces before declaring quartet complete
TOLTECPIPE_VALIDATION_TIMEOUT_SECONDS=30.0

# --- Dagster backend (PostgreSQL for two-machine shared state) ---
# Both Machine A (tolteca_db) and Machine B (toltecpipe) must use the same
# PostgreSQL.  Set DAGSTER_HOME to point at dagster.yaml with the URL.
#
# The connection URL goes in dagster.yaml (not here) to keep it out of env.
# Alternatively, uncomment and fill in:
# TOLTECPIPE_DAGSTER_POSTGRES_URL=postgresql://dagster:PASSWORD@DBHOST:5432/dagster
